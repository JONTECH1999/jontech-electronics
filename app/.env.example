# ==============================================================================
# KitFlow - Embedded Shopify Merchant Application Environment Configuration
# ==============================================================================

# Server & Runtime Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Shopify App Credentials (from Shopify Partner Dashboard)
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=https://your-ngrok-or-tunnel-url.ngrok-free.app
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory,write_inventory,read_customers
SHOPIFY_API_VERSION=2026-07

# Public client ID used by Shopify App Bridge in the built embedded app.
VITE_SHOPIFY_API_KEY=your_shopify_api_key_here

# Database Configuration (MySQL + Drizzle ORM)
# Format: mysql://user:password@host:port/database_name
DATABASE_URL=mysql://root:password@127.0.0.1:3306/kitflow_db

# Anthropic Claude API Configuration (Server-Side Only - Never Exposed to Frontend)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Safe Offline Development / Demo Mode
# Set to 'true' to run KitFlow with realistic mock Shopify data and local SQLite/memory DB
# Set to 'false' in production with live Shopify credentials and MySQL
USE_DEMO_DATA=true
DEMO_SHOP_DOMAIN=jontech-electronics.myshopify.com
