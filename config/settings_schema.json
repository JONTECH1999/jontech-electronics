[
  {
    "name": "theme_info",
    "theme_name": "JonTech Modern",
    "theme_version": "1.0.0",
    "theme_author": "JonTech Engineering",
    "theme_documentation_url": "https://github.com/jontech/kitflow",
    "theme_support_url": "https://jontech.example.com/support"
  },
  {
    "name": "Brand Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#0B0F17"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card & Surface Background",
        "default": "#131B2A"
      },
      {
        "type": "color",
        "id": "color_surface_hover",
        "label": "Surface Hover",
        "default": "#1C273C"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Subtle Border",
        "default": "#22304A"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Accent (Tech Cyan)",
        "default": "#00E5FF"
      },
      {
        "type": "color",
        "id": "color_primary_hover",
        "label": "Primary Hover",
        "default": "#33ECFF"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Secondary Accent (Cobalt Blue)",
        "default": "#3B82F6"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Main Text",
        "default": "#F3F4F6"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted Text",
        "default": "#94A3B8"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / Discount Accent",
        "default": "#10B981"
      },
      {
        "type": "color",
        "id": "color_warning",
        "label": "Warning / Low Stock Accent",
        "default": "#F59E0B"
      }
    ]
  },
  {
    "name": "Typography & Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_max_width",
        "min": 1000,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "label": "Container Max Width",
        "default": 1280
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 16,
        "step": 2,
        "unit": "px",
        "label": "Base Border Radius",
        "default": 8
      }
    ]
  },
  {
    "name": "Store Info & Social Links",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Store Display Name",
        "default": "JonTech Electronics"
      },
      {
        "type": "text",
        "id": "currency_symbol",
        "label": "Currency Symbol",
        "default": "₱"
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "Support Email",
        "default": "support@jontech-electronics.com"
      },
      {
        "type": "url",
        "id": "social_twitter",
        "label": "X / Twitter URL"
      },
      {
        "type": "url",
        "id": "social_github",
        "label": "GitHub URL"
      }
    ]
  }
]
