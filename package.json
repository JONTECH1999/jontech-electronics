{
  "name": "kitflow-monorepo",
  "version": "1.0.0",
  "description": "KitFlow Shopify Embedded App and JonTech Electronics Storefront Theme",
  "private": true,
  "workspaces": [
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix app/backend run dev",
    "dev:frontend": "npm --prefix app/frontend run dev",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix app run build",
    "start": "npm --prefix app/backend run start",
    "test": "npm --prefix app test",
    "lint": "npm --prefix app run lint",
    "typecheck": "npm --prefix app run typecheck",
    "db:generate": "npm --prefix app/backend run db:generate",
    "db:migrate": "npm --prefix app/backend run db:migrate",
    "seed": "npm --prefix app/backend run seed",
    "sync:shopify": "npx tsx app/scripts/sync-products-to-shopify.ts",
    "push:theme": "node app/scripts/sync-theme-branch.js"
  },
  "keywords": [
    "shopify",
    "embedded-app",
    "shopify-theme",
    "liquid",
    "drizzle-orm",
    "anthropic",
    "claude",
    "product-bundles"
  ],
  "author": "JonTech Engineering",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
