{% comment %}
  JonTech Electronics - Cart Main Section
  Warm Linen & Beige Aesthetic with Free Shipping Progress Bar
{% endcomment %}

<section class="cart-page" role="region" aria-label="Shopping Cart">
  <div class="container">
    <div class="section-header">
      <h1 class="section-title">Your Prototyping Cart</h1>
      <p class="section-subtitle">
        Review your selected development boards, sensors, and robotics hardware before secure checkout.
      </p>
    </div>

    {%- if cart.item_count > 0 -%}
      {%- liquid
        assign free_shipping_threshold = 150000
        assign remaining_cents = free_shipping_threshold | minus: cart.total_price
        assign progress_percent = cart.total_price | times: 100.0 | divided_by: free_shipping_threshold
        if progress_percent > 100
          assign progress_percent = 100
        endif
      -%}

      <!-- Free Express Shipping Meter -->
      <div class="free-shipping-bar-card">
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9375rem; font-weight: 700; color: var(--color-heading);">
          {%- if remaining_cents > 0 -%}
            {%- assign remaining_str = remaining_cents | money_without_currency -%}
            <span>📦 Add ₱{{ remaining_str }} more to unlock FREE Express Courier Shipping!</span>
          {%- else -%}
            <span style="color: var(--color-sale);">🎉 You have qualified for FREE Express Courier Delivery across the Philippines!</span>
          {%- endif -%}
          <span style="font-size: 0.8125rem; color: var(--color-text-dim);">Threshold: ₱1,500.00</span>
        </div>
        <div class="shipping-progress-track">
          <div class="shipping-progress-fill" style="width: {{ progress_percent }}%;"></div>
        </div>
      </div>

      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-table-wrapper">
          <table class="cart-table">
            <thead>
              <tr>
                <th>Hardware Item</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th aria-label="Actions"></th>
              </tr>
            </thead>
            <tbody>
              {%- for item in cart.items -%}
                <tr>
                  <!-- Product Column -->
                  <td>
                    <div class="cart-item-flex">
                      {%- if item.image != blank -%}
                        <img
                          src="{{ item.image | image_url: width: 150 }}"
                          alt="{{ item.title | escape }}"
                          class="cart-item-thumb"
                          width="72"
                          height="72"
                        >
                      {%- else -%}
                        <div class="cart-item-thumb" style="display: flex; align-items: center; justify-content: center; background: var(--color-surface-hover);">
                          <span style="color: var(--color-primary);">{% render 'icon', name: 'cpu' %}</span>
                        </div>
                      {%- endif -%}

                      <div>
                        <div class="cart-item-title">
                          <a href="{{ item.url }}">{{ item.product.title }}</a>
                        </div>
                        {%- unless item.product.has_only_default_variant -%}
                          <div class="cart-item-variant">{{ item.variant.title }}</div>
                        {%- endunless -%}

                        {%- if item.line_level_discount_allocations.size > 0 -%}
                          <div style="margin-top: 0.25rem;">
                            {%- for discount in item.line_level_discount_allocations -%}
                              {% render 'badge', type: 'sale', text: discount.discount_application.title %}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </td>

                  <!-- Unit Price -->
                  <td>
                    <div class="price-container">
                      {%- assign item_price = item.original_price | money -%}
                      {%- if item_price contains '$' or cart.currency.iso_code == 'PHP' or settings.currency_symbol == '₱' or settings.currency_symbol == blank -%}
                        <span class="price-current" style="font-size: 1.0625rem;">₱{{ item.original_price | money_without_currency }}</span>
                      {%- else -%}
                        <span class="price-current" style="font-size: 1.0625rem;">{{ item_price }}</span>
                      {%- endif -%}
                    </div>
                  </td>

                  <!-- Quantity -->
                  <td>
                    <div class="quantity-selector" data-qty-wrapper style="display: inline-flex;">
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="quantity-btn" aria-label="Decrease quantity">-</a>
                      <input
                        type="number"
                        name="updates[]"
                        id="updates_{{ item.key }}"
                        value="{{ item.quantity }}"
                        min="0"
                        class="quantity-input"
                        aria-label="Quantity for {{ item.title }}"
                      >
                      <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="quantity-btn" aria-label="Increase quantity">+</a>
                    </div>
                  </td>

                  <!-- Line Total -->
                  <td>
                    <div class="price-current" style="font-size: 1.125rem;">
                      {%- assign line_price = item.final_line_price | money -%}
                      {%- if line_price contains '$' or cart.currency.iso_code == 'PHP' or settings.currency_symbol == '₱' or settings.currency_symbol == blank -%}
                        ₱{{ item.final_line_price | money_without_currency }}
                      {%- else -%}
                        {{ line_price }}
                      {%- endif -%}
                    </div>
                  </td>

                  <!-- Remove -->
                  <td style="text-align: right;">
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                      class="cart-item-remove"
                      aria-label="Remove {{ item.title }}"
                    >
                      {% render 'icon', name: 'trash' %}
                    </a>
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        <!-- Cart Summary Card -->
        <div class="cart-summary-card">
          <h3 style="font-size: 1.35rem; margin-bottom: 1.25rem; color: var(--color-heading); font-weight: 800;">Order Summary</h3>

          <div class="cart-summary-row">
            <span style="color: var(--color-text-muted);">Estimated Subtotal</span>
            {%- assign subtotal_price = cart.total_price | money -%}
            {%- if subtotal_price contains '$' or cart.currency.iso_code == 'PHP' or settings.currency_symbol == '₱' or settings.currency_symbol == blank -%}
              <span style="font-weight: 800; color: var(--color-heading);">₱{{ cart.total_price | money_without_currency }}</span>
            {%- else -%}
              <span style="font-weight: 800; color: var(--color-heading);">{{ subtotal_price }}</span>
            {%- endif -%}
          </div>

          <div style="font-size: 0.8125rem; color: var(--color-text-dim); margin-bottom: 1.5rem; line-height: 1.55;">
            Taxes included where applicable. Every shipment includes JonTech 2-Year Precision Warranty and express courier dispatch from Manila.
          </div>

          <!-- Order Note -->
          <div style="margin-bottom: 1.5rem;">
            <label for="CartNote" style="display: block; font-size: 0.8125rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-heading);">
              Delivery instructions / school PO notes (optional):
            </label>
            <textarea
              name="note"
              id="CartNote"
              rows="3"
              style="width: 100%; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 0.75rem; color: var(--color-heading); font-family: inherit; resize: vertical;"
            >{{ cart.note }}</textarea>
          </div>

          <button type="submit" name="checkout" class="btn btn--primary btn--lg btn--full">
            Proceed to Checkout
            {% render 'icon', name: 'chevron-right' %}
          </button>

          <div style="margin-top: 1.25rem; text-align: center;">
            <a href="{{ routes.all_products_collection_url }}" style="font-size: 0.875rem; color: var(--color-text-muted); font-weight: 600;">
              ← Continue Shopping in Hardware Catalog
            </a>
          </div>
        </div>
      </form>
    {%- else -%}
      <!-- Empty Cart State -->
      <div style="text-align: center; padding: 5rem 2rem; background: var(--color-surface); border-radius: var(--radius-xl); border: 1px solid var(--color-border); max-width: 640px; margin: 0 auto; box-shadow: var(--shadow-sm);">
        <div style="color: var(--color-primary); margin-bottom: 1.5rem;">
          {% render 'icon', name: 'cart', class: 'placeholder-icon' %}
        </div>
        <h2 style="font-size: 1.75rem; margin-bottom: 0.75rem; color: var(--color-heading); font-weight: 800;">Your cart is currently empty</h2>
        <p style="color: var(--color-text-muted); margin-bottom: 2rem; line-height: 1.6;">
          You haven't added any electronic development boards or prototyping kits yet. Use our interactive lab configurator to design your custom maker setup.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="{{ routes.root_url }}#lab-configurator" class="btn btn--primary btn--lg">
            Build My Custom Kit
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--secondary btn--lg">
            Browse Hardware Catalog
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Main",
  "settings": []
}
{% endschema %}
