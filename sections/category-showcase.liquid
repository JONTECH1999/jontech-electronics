{% comment %}
  JonTech Electronics - Category Showcase Section
{% endcomment %}

<section id="categories" class="category-showcase-section" style="padding: 5rem 0;" role="region" aria-label="Curated Categories">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        {{ section.settings.title | default: 'Curated Electronics & Prototyping Categories' }}
      </h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Engineering development boards, precision sensors, robotics modules, and academic prototyping kits.' }}
      </p>
    </div>

    <div class="category-grid">
      <!-- Category 1: Microcontrollers -->
      <a href="{{ section.settings.cat1_url | default: '/collections/microcontrollers' }}" class="category-card">
        <div class="category-card__icon">
          {% render 'icon', name: 'cpu' %}
        </div>
        <h3 class="category-card__title">{{ section.settings.cat1_title | default: 'Microcontrollers & Dev Boards' }}</h3>
        <p class="category-card__desc">{{ section.settings.cat1_desc | default: 'ESP32 dual-core WiFi/BLE, Arduino Uno R3, STM32 ARM Cortex-M4, and Raspberry Pi 4 SBCs.' }}</p>
        <span class="category-card__link">
          Explore Microcontrollers
          {% render 'icon', name: 'chevron-right' %}
        </span>
      </a>

      <!-- Category 2: Sensors -->
      <a href="{{ section.settings.cat2_url | default: '/collections/sensors' }}" class="category-card">
        <div class="category-card__icon">
          {% render 'icon', name: 'zap' %}
        </div>
        <h3 class="category-card__title">{{ section.settings.cat2_title | default: 'Sensors & Environmental' }}</h3>
        <p class="category-card__desc">{{ section.settings.cat2_desc | default: 'DHT22 temp & humidity, HC-SR04 ultrasonic ranging, TFmini-S ToF LiDAR, and analog transducers.' }}</p>
        <span class="category-card__link">
          Explore Sensors
          {% render 'icon', name: 'chevron-right' %}
        </span>
      </a>

      <!-- Category 3: Robotics -->
      <a href="{{ section.settings.cat3_url | default: '/collections/robotics' }}" class="category-card">
        <div class="category-card__icon">
          {% render 'icon', name: 'shield' %}
        </div>
        <h3 class="category-card__title">{{ section.settings.cat3_title | default: 'Robotics & Motor Drivers' }}</h3>
        <p class="category-card__desc">{{ section.settings.cat3_desc | default: 'L298N dual H-bridge motor drivers, SG90 micro servos, 4-channel relays, and robot chassis gear.' }}</p>
        <span class="category-card__link">
          Explore Robotics
          {% render 'icon', name: 'chevron-right' %}
        </span>
      </a>

      <!-- Category 4: Prototyping -->
      <a href="{{ section.settings.cat4_url | default: '/collections/prototyping' }}" class="category-card">
        <div class="category-card__icon">
          {% render 'icon', name: 'truck' %}
        </div>
        <h3 class="category-card__title">{{ section.settings.cat4_title | default: 'Prototyping & Displays' }}</h3>
        <p class="category-card__desc">{{ section.settings.cat4_desc | default: '0.96 inch I2C OLED displays, 830-point solderless breadboards, jumper wire kits, and power modules.' }}</p>
        <span class="category-card__link">
          Explore Prototyping
          {% render 'icon', name: 'chevron-right' %}
        </span>
      </a>
    </div>
  </div>
</section>

