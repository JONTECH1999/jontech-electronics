{% comment %}
  JonTech Electronics - Amazon-Style Category Showcase Section with Rich Photography
{% endcomment %}

<section id="categories" class="category-showcase-section" style="padding: 4rem 0;" role="region" aria-label="Curated Categories">
  <div class="container">
    <div class="section-header section-header--center">
      <div style="margin-bottom: 0.5rem;">
        <span class="jt-badge jt-badge--deal">SHOP BY DEPARTMENT</span>
      </div>
      <h2 class="section-title">
        {{ section.settings.title | default: 'Curated Electronics & Prototyping Departments' }}
      </h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Select high-grade electronics tested for STEM universities, IoT telemetry, and industrial automation.' }}
      </p>
    </div>

    <div class="jt-cat-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link_url | default: '#featured-hardware' }}" class="jt-cat-card" {{ block.shopify_attributes }}>
          <div class="jt-cat-media">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 1200 }}"
                alt="{{ block.settings.title | escape }}"
                class="jt-cat-img"
                width="600"
                height="400"
                loading="lazy"
              >
            {% else %}
              <img
                src="https://images.unsplash.com/photo-1553406830-ef2513450d76?w=600&auto=format&fit=crop&q=80"
                alt="Category image"
                class="jt-cat-img"
                width="600"
                height="400"
                loading="lazy"
              >
            {% endif %}

            {% if block.settings.tag != blank %}
              <span class="jt-cat-tag">{{ block.settings.tag }}</span>
            {% endif %}
          </div>

          <div class="jt-cat-body">
            <h3 class="jt-cat-title">{{ block.settings.title | default: 'Category Title' }}</h3>
            <p class="jt-cat-desc">{{ block.settings.description | default: 'Add a description for this category.' }}</p>

            <div class="jt-cat-footer">
              {% if block.settings.price != blank %}
                <span class="jt-cat-price">{{ block.settings.price }}</span>
              {% endif %}

              <span class="jt-cat-link">{{ block.settings.link_text | default: 'Shop Now' }} →</span>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Showcase",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge text",
          "default": "4 Models"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Microcontrollers & Compute"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "ESP32 dual-core WiFi/BLE, Arduino Uno R3, STM32 ARM M4, and Raspberry Pi 4."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price text",
          "default": "From ₱240.00"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Curated Electronics & Prototyping Departments"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Select high-grade electronics tested for STEM universities, IoT telemetry, and industrial automation."
    }
  ],
  "presets": [
    {
      "name": "Category Showcase",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "tag": "4 Models",
            "title": "Microcontrollers & Compute",
            "description": "ESP32 dual-core WiFi/BLE, Arduino Uno R3, STM32 ARM M4, and Raspberry Pi 4.",
            "price": "From ₱240.00",
            "link_text": "Shop Now",
            "link_url": "#featured-hardware"
          }
        },
        {
          "type": "category",
          "settings": {
            "tag": "4 Sensors",
            "title": "Sensors & Telemetry",
            "description": "DHT22 digital temp/humidity, HC-SR04 ultrasonic, and TFmini-S ToF LiDAR.",
            "price": "From ₱85.00",
            "link_text": "Shop Now",
            "link_url": "#featured-hardware"
          }
        },
        {
          "type": "category",
          "settings": {
            "tag": "3 Modules",
            "title": "Robotics & Motor Control",
            "description": "L298N dual H-bridge motor drivers, SG90 micro servos, and opto-isolated relays.",
            "price": "From ₱95.00",
            "link_text": "Shop Now",
            "link_url": "#featured-hardware"
          }
        },
        {
          "type": "category",
          "settings": {
            "tag": "Lab Gear",
            "title": "Prototyping & Displays",
            "description": "0.96\" I2C OLED displays, 830-point breadboards, and flexible jumper wire kits.",
            "price": "From ₱145.00",
            "link_text": "Shop Now",
            "link_url": "#featured-hardware"
          }
        }
      ]
    }
  ]
}
{% endschema %}
