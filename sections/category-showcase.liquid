{% comment %}
  JonTech Electronics - Amazon-Style Category Showcase Section with Rich Photography
{% endcomment %}

<section id="categories" class="category-showcase-section" style="padding: 4rem 0;" role="region" aria-label="Curated Categories">
  <div class="container">
    <div class="section-header section-header--center">
      <div style="margin-bottom: 0.5rem;">
        <span class="jt-badge jt-badge--deal">SHOP BY DEPARTMENT</span>
      </div>
      <h2 class="section-title">
        {{ section.settings.title | default: 'Curated Electronics & Prototyping Departments' }}
      </h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Select high-grade electronics tested for STEM universities, IoT telemetry, and industrial automation.' }}
      </p>
    </div>

    <div class="jt-cat-grid">
      <!-- Category 1: Microcontrollers -->
      <a href="#featured-hardware" class="jt-cat-card">
        <div class="jt-cat-media">
          <img 
            src="https://images.unsplash.com/photo-1553406830-ef2513450d76?w=600&auto=format&fit=crop&q=80" 
            alt="Microcontrollers and Dev Boards" 
            class="jt-cat-img"
            width="600"
            height="400"
            loading="lazy"
          >
          <span class="jt-cat-tag">4 Models</span>
        </div>
        <div class="jt-cat-body">
          <h3 class="jt-cat-title">Microcontrollers & Compute</h3>
          <p class="jt-cat-desc">ESP32 dual-core WiFi/BLE, Arduino Uno R3, STM32 ARM M4, & Raspberry Pi 4.</p>
          <div class="jt-cat-footer">
            <span class="jt-cat-price">From ₱240.00</span>
            <span class="jt-cat-link">Shop Now →</span>
          </div>
        </div>
      </a>

      <!-- Category 2: Sensors -->
      <a href="#featured-hardware" class="jt-cat-card">
        <div class="jt-cat-media">
          <img 
            src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=600&auto=format&fit=crop&q=80" 
            alt="Sensors and Telemetry" 
            class="jt-cat-img"
            width="600"
            height="400"
            loading="lazy"
          >
          <span class="jt-cat-tag">4 Sensors</span>
        </div>
        <div class="jt-cat-body">
          <h3 class="jt-cat-title">Sensors & Telemetry</h3>
          <p class="jt-cat-desc">DHT22 digital temp/humidity, HC-SR04 ultrasonic, and TFmini-S ToF LiDAR.</p>
          <div class="jt-cat-footer">
            <span class="jt-cat-price">From ₱85.00</span>
            <span class="jt-cat-link">Shop Now →</span>
          </div>
        </div>
      </a>

      <!-- Category 3: Robotics -->
      <a href="#featured-hardware" class="jt-cat-card">
        <div class="jt-cat-media">
          <img 
            src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=600&auto=format&fit=crop&q=80" 
            alt="Robotics & Motor Drivers" 
            class="jt-cat-img"
            width="600"
            height="400"
            loading="lazy"
          >
          <span class="jt-cat-tag">3 Modules</span>
        </div>
        <div class="jt-cat-body">
          <h3 class="jt-cat-title">Robotics & Motor Control</h3>
          <p class="jt-cat-desc">L298N dual H-bridge motor drivers, SG90 micro servos, and opto-isolated relays.</p>
          <div class="jt-cat-footer">
            <span class="jt-cat-price">From ₱95.00</span>
            <span class="jt-cat-link">Shop Now →</span>
          </div>
        </div>
      </a>

      <!-- Category 4: Prototyping -->
      <a href="#featured-hardware" class="jt-cat-card">
        <div class="jt-cat-media">
          <img 
            src="https://images.unsplash.com/photo-1555664424-778a1e5e1b48?w=600&auto=format&fit=crop&q=80" 
            alt="Prototyping & Displays" 
            class="jt-cat-img"
            width="600"
            height="400"
            loading="lazy"
          >
          <span class="jt-cat-tag">Lab Gear</span>
        </div>
        <div class="jt-cat-body">
          <h3 class="jt-cat-title">Prototyping & Displays</h3>
          <p class="jt-cat-desc">0.96" I2C OLED displays, 830-point breadboards, and flexible jumper wire kits.</p>
          <div class="jt-cat-footer">
            <span class="jt-cat-price">From ₱145.00</span>
            <span class="jt-cat-link">Shop Now →</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Showcase",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Curated Electronics & Prototyping Departments"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Select high-grade electronics tested for STEM universities, IoT telemetry, and industrial automation."
    }
  ],
  "presets": [
    {
      "name": "Category Showcase"
    }
  ]
}
{% endschema %}
