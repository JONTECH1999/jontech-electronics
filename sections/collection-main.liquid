{% comment %}
  JonTech Electronics - Collection Main Section
{% endcomment %}

<section class="collection-page" role="region" aria-label="Collection Products">
  <div class="container">
    <div class="collection-header-banner">
      <div style="margin-bottom: 0.5rem;">
        <a href="/" style="font-size: 0.8125rem; color: var(--color-text-dim);">← Back to Storefront</a>
      </div>
      <h1 class="section-title">
        {{ collection.title | default: 'All Hardware & Curated Setups' }}
      </h1>
      {%- if collection.description != blank -%}
        <p class="section-subtitle">
          {{ collection.description }}
        </p>
      {%- else -%}
        <p class="section-subtitle">
          Explore our complete catalog of performance gear, ergonomic accessories, and scored bundle packages.
        </p>
      {%- endif -%}
    </div>

    <!-- Toolbar: Sorting & Count -->
    <div class="collection-toolbar">
      <div style="font-size: 0.875rem; color: var(--color-text-muted);">
        Showing {{ collection.products_count | default: 8 }} products
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <label for="SortBy" style="font-size: 0.875rem; color: var(--color-text-muted);">Sort by:</label>
        <select id="SortBy" class="sort-select" onchange="location = this.value;">
          <option value="{{ collection.url }}?sort_by=best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
          <option value="{{ collection.url }}?sort_by=price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="{{ collection.url }}?sort_by=price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="{{ collection.url }}?sort_by=created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest Releases</option>
        </select>
      </div>
    </div>

    {%- paginate collection.products by section.settings.products_per_page | default: 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 3.5rem;" aria-label="Pagination">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <!-- Empty State -->
        <div style="text-align: center; padding: 5rem 1rem; background: var(--color-surface); border-radius: var(--radius-xl); border: 1px solid var(--color-border);">
          <div style="color: var(--color-text-dim); margin-bottom: 1rem;">
            {% render 'icon', name: 'search' %}
          </div>
          <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem; color: #fff;">No Products Found</h3>
          <p style="color: var(--color-text-muted); margin-bottom: 1.5rem; max-width: 480px; margin-left: auto; margin-right: auto;">
            There are currently no products matching this collection. Explore our featured setups or use our interactive setup matcher.
          </p>
          <a href="/#build-my-setup" class="btn btn--primary">
            Build My Setup
          </a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 24,
      "step": 6,
      "label": "Products per page",
      "default": 12
    }
  ]
}
{% endschema %}
