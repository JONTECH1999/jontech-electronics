{% comment %}
  JonTech Electronics - Amazon Search Results Landing Layout
  Modeled after Amazon USA Search Pattern adapted to Warm Linen/Beige Palette
{% endcomment %}

<section id="featured-hardware" class="jt-amazon-search-page" role="region" aria-label="Amazon Hardware Search Results">
  <div class="jt-amazon-container">

    <!-- Top Alert Strip (Amazon area delivery advisories) -->
    <div class="jt-alert-strip" role="alert">
      <div class="jt-alert-content">
        {% render 'icon', name: 'alert', class: 'jt-alert-icon' %}
        <span class="jt-alert-text">Extended delivery time in your area. Manila Express, STEM Priority & Lab Orders operating normally.</span>
      </div>
      <button type="button" class="jt-alert-dismiss" aria-label="Dismiss alert" onclick="this.closest('.jt-alert-strip').style.display='none';">Dismiss</button>
    </div>

    <!-- Top Query Counter & Sort Bar -->
    <div class="jt-results-query-bar">
      <div class="jt-query-counter">
        <span>1-12 of 12 results for</span>
        <strong class="jt-query-term">"jontech electronics"</strong>
      </div>
      <div class="jt-sort-control small-hide">
        <label for="jtSortSelect" class="jt-sort-label">Sort by:</label>
        <select id="jtSortSelect" class="jt-sort-select" aria-label="Sort search results">
          <option value="featured" selected>Featured</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="rating">Avg. Customer Review</option>
          <option value="newest">Newest Arrivals</option>
        </select>
      </div>
    </div>

    <!-- Amazon Brand Spotlight Banner (JonTech Essentials / Certified Lab) -->
    <div class="jt-brand-spotlight-card">
      <div class="jt-brand-spotlight-inner">
        <div class="jt-brand-spotlight-badge">
          {% render 'icon', name: 'zap', class: 'jt-brand-logo-mark' %}
          <span class="jt-brand-name">JONTECH LAB</span>
        </div>
        <div class="jt-brand-spotlight-details">
          <span class="jt-brand-pill">Featured Hardware Brand</span>
          <h3 class="jt-brand-spotlight-title">You're shopping JonTech Certified STEM & IoT Electronics</h3>
          <p class="jt-brand-spotlight-desc">Gold-flashed pinouts, automated 3.3V/5V logic isolation test, and official 2-year warranty replacement across the Philippines.</p>
        </div>
        <div class="jt-brand-spotlight-action">
          <a href="#lab-configurator" class="jt-brand-spotlight-link">Explore Lab Builder →</a>
        </div>
      </div>
    </div>

    <!-- Results Subheader -->
    <div class="jt-results-heading-row">
      <h2 class="jt-results-title">Results</h2>
      <p class="jt-results-notice">Check each product page for other buying options. Price and other details may vary based on product size, pin configuration, and bundle package.</p>
    </div>

    <!-- Mobile Filter & Sort Bar (<990px) -->
    <div class="jt-mobile-filter-bar medium-hide large-up-hide">
      <button type="button" class="jt-mobile-filter-btn" id="jtMobileFilterToggle" aria-label="Open filter menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <line x1="1" y1="14" x2="7" y2="14"></line>
          <line x1="9" y1="8" x2="15" y2="8"></line>
          <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
        <span>Filters (<span id="jtActiveFilterCountMobile">12</span>)</span>
      </button>
      <div class="jt-mobile-sort-wrap">
        <select id="jtMobileSortSelect" class="jt-sort-select" aria-label="Sort results mobile">
          <option value="featured">Sort: Featured</option>
          <option value="price-low">Price: Low to High</option>
          <option value="price-high">Price: High to Low</option>
          <option value="rating">Avg. Review</option>
        </select>
      </div>
    </div>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div class="jt-sidebar-overlay" id="jtSidebarOverlay"></div>

    <!-- Two-Column Shopping Stream (Sticky Sidebar + Product Cards) -->
    <div class="jt-amazon-layout">

      <!-- Amazon Sticky Refinement Sidebar -->
      <aside class="jt-sidebar" id="jtSidebar" aria-label="Search Refinements">
        <div class="jt-sidebar-mobile-header medium-hide large-up-hide">
          <h3>Filters & Refinements</h3>
          <button type="button" class="jt-sidebar-close-btn" id="jtSidebarCloseBtn" aria-label="Close filters">{% render 'icon', name: 'close' %}</button>
        </div>

        <!-- Fast Delivery Area Card -->
        <div class="jt-sidebar-banner">
          {% render 'icon', name: 'zap', class: 'jt-sb-banner-icon' %}
          <div>
            <strong>Fast Delivery in your area</strong>
            <p>Order today for next-day dispatch across Metro Manila.</p>
          </div>
        </div>

        <!-- Popular Departments -->
        <div class="jt-sidebar-group">
          <h4 class="jt-sidebar-heading">Popular Departments</h4>
          <ul class="jt-sidebar-list">
            <li><a href="javascript:void(0)" class="jt-sb-filter-link active" data-sb-filter="all"><span class="sb-bullet">▸</span> All Hardware <span class="jt-sb-count">(12)</span></a></li>
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-filter="mcu"><span class="sb-bullet">▸</span> Microcontrollers & SBCs <span class="jt-sb-count">(4)</span></a></li>
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-filter="sensors"><span class="sb-bullet">▸</span> Sensors & Displays <span class="jt-sb-count">(4)</span></a></li>
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-filter="robotics"><span class="sb-bullet">▸</span> Robotics & Motor Drivers <span class="jt-sb-count">(3)</span></a></li>
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-filter="prototyping"><span class="sb-bullet">▸</span> Breadboards & Wiring <span class="jt-sb-count">(1)</span></a></li>
          </ul>
        </div>

        <!-- Delivery & Shipping -->
        <div class="jt-sidebar-group">
          <h4 class="jt-sidebar-heading">Delivery & Shipping</h4>
          <label class="jt-sb-checkbox-label">
            <input type="checkbox" id="filterFreeShip" class="jt-sb-checkbox" checked>
            <span class="jt-sb-custom-check"></span>
            <span>Eligible for Free Shipping</span>
          </label>
          <label class="jt-sb-checkbox-label">
            <input type="checkbox" id="filterExpress" class="jt-sb-checkbox" checked>
            <span class="jt-sb-custom-check"></span>
            <span>{% render 'icon', name: 'truck', class: 'jt-inline-icon' %} Express Next-Day Delivery</span>
          </label>
        </div>

        <!-- Customer Reviews -->
        <div class="jt-sidebar-group">
          <h4 class="jt-sidebar-heading">Customer Reviews</h4>
          <div class="jt-sb-stars-list">
            <a href="javascript:void(0)" class="jt-sb-star-row active" data-sb-rating="4">
              <span class="jt-stars">★★★★☆</span>
              <span class="jt-sb-star-text">& Up (4.0+)</span>
            </a>
            <a href="javascript:void(0)" class="jt-sb-star-row" data-sb-rating="4.8">
              <span class="jt-stars">★★★★★</span>
              <span class="jt-sb-star-text">(4.8+ Top Rated)</span>
            </a>
          </div>
        </div>

        <!-- Verified Brands -->
        <div class="jt-sidebar-group">
          <h4 class="jt-sidebar-heading">Verified Brands</h4>
          <label class="jt-sb-checkbox-label"><input type="checkbox" class="jt-sb-checkbox" checked><span>Espressif Systems</span></label>
          <label class="jt-sb-checkbox-label"><input type="checkbox" class="jt-sb-checkbox" checked><span>Arduino Official / Clone</span></label>
          <label class="jt-sb-checkbox-label"><input type="checkbox" class="jt-sb-checkbox" checked><span>Raspberry Pi Foundation</span></label>
          <label class="jt-sb-checkbox-label"><input type="checkbox" class="jt-sb-checkbox" checked><span>STMicroelectronics</span></label>
          <label class="jt-sb-checkbox-label"><input type="checkbox" class="jt-sb-checkbox" checked><span>JonTech Certified Lab</span></label>
        </div>

        <!-- Price Range (₱) -->
        <div class="jt-sidebar-group">
          <h4 class="jt-sidebar-heading">Price Range (₱)</h4>
          <ul class="jt-sidebar-list">
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-price="all">All Prices</a></li>
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-price="under-200">Under ₱200.00</a></li>
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-price="200-500">₱200.00 to ₱500.00</a></li>
            <li><a href="javascript:void(0)" class="jt-sb-filter-link" data-sb-price="over-500">Over ₱500.00</a></li>
          </ul>
        </div>

        <!-- Hardware Condition -->
        <div class="jt-sidebar-group">
          <h4 class="jt-sidebar-heading">Hardware Condition</h4>
          <label class="jt-sb-checkbox-label"><input type="checkbox" class="jt-sb-checkbox" checked><span>New (Factory Fresh)</span></label>
          <label class="jt-sb-checkbox-label"><input type="checkbox" class="jt-sb-checkbox" checked><span>2-Year Full Replacement</span></label>
        </div>

        <div class="jt-sidebar-mobile-footer medium-hide large-up-hide">
          <button type="button" class="btn btn--amazon" id="jtApplyFiltersBtn">Apply Filters</button>
        </div>
      </aside>

