<!-- Cart Added Notification Toast -->
<div id="jt-toast" class="jt-toast" role="alert" aria-live="polite">
  <span class="jt-toast-icon">✓</span>
  <span id="jt-toast-msg">Added to cart!</span>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sbFilterLinks = document.querySelectorAll('.jt-sb-filter-link[data-sb-filter]');
    const sbPriceLinks = document.querySelectorAll('.jt-sb-filter-link[data-sb-price]');
    const cards = Array.from(document.querySelectorAll('.jt-card'));
    const sortSelect = document.getElementById('jtSortSelect');
    const mobileSortSelect = document.getElementById('jtMobileSortSelect');
    const gridEl = document.querySelector('.jt-product-grid');
    const mobileFilterToggle = document.getElementById('jtMobileFilterToggle');
    const sidebarCloseBtn = document.getElementById('jtSidebarCloseBtn');
    const sidebarOverlay = document.getElementById('jtSidebarOverlay');
    const sidebar = document.getElementById('jtSidebar');
    const applyFiltersBtn = document.getElementById('jtApplyFiltersBtn');
    const mobileCountEl = document.getElementById('jtActiveFilterCountMobile');
    const queryTermEl = document.querySelector('.jt-query-term');

    let currentDept = 'all';
    let currentPrice = 'all';

    function updateCardVisibility() {
      let visibleCount = 0;
      cards.forEach(card => {
        const cat = card.getAttribute('data-cat');
        const price = parseFloat(card.getAttribute('data-price') || '0');

        let matchDept = (currentDept === 'all' || cat === currentDept);
        let matchPrice = true;
        if (currentPrice === 'under-200') matchPrice = (price < 200);
        else if (currentPrice === '200-500') matchPrice = (price >= 200 && price <= 500);
        else if (currentPrice === 'over-500') matchPrice = (price > 500);

        if (matchDept && matchPrice) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (mobileCountEl) mobileCountEl.textContent = visibleCount;
      const counterSpan = document.querySelector('.jt-query-counter span');
      if (counterSpan) {
        counterSpan.textContent = `1-${visibleCount} of ${visibleCount} results for`;
      }
    }

    // Department Sidebar filtering
    sbFilterLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        sbFilterLinks.forEach(l => l.classList.remove('active'));
        this.classList.add('active');
        currentDept = this.getAttribute('data-sb-filter') || 'all';
        if (queryTermEl) {
          const names = {
            'all': '"jontech electronics"',
            'mcu': '"microcontrollers & SBCs"',
            'sensors': '"sensors & displays"',
            'robotics': '"robotics & motor drivers"',
            'prototyping': '"breadboards & wiring"'
          };
          queryTermEl.textContent = names[currentDept] || '"jontech electronics"';
        }
        updateCardVisibility();
      });
    });

    // Price Filtering
    sbPriceLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        sbPriceLinks.forEach(l => l.classList.remove('active'));
        this.classList.add('active');
        currentPrice = this.getAttribute('data-sb-price') || 'all';
        updateCardVisibility();
      });
    });

    // Mobile Filter Drawer Toggle
    function openSidebar() {
      if (sidebar) sidebar.classList.add('jt-sidebar--open');
      if (sidebarOverlay) sidebarOverlay.classList.add('visible');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      if (sidebar) sidebar.classList.remove('jt-sidebar--open');
      if (sidebarOverlay) sidebarOverlay.classList.remove('visible');
      document.body.style.overflow = '';
    }

    if (mobileFilterToggle) mobileFilterToggle.addEventListener('click', openSidebar);
    if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeSidebar);
    if (sidebarOverlay) sidebarOverlay.addEventListener('click', closeSidebar);
    if (applyFiltersBtn) applyFiltersBtn.addEventListener('click', closeSidebar);

    // Sorting Logic
    function applySort(val) {
      const sorted = [...cards].sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || '0');
        const priceB = parseFloat(b.getAttribute('data-price') || '0');
        const ratingA = parseFloat(a.getAttribute('data-rating') || '0');
        const ratingB = parseFloat(b.getAttribute('data-rating') || '0');

        if (val === 'price-low') return priceA - priceB;
        if (val === 'price-high') return priceB - priceA;
        if (val === 'rating') return ratingB - ratingA;
        return 0; // featured/default
      });

      if (gridEl) {
        sorted.forEach(card => gridEl.appendChild(card));
      }
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        if (mobileSortSelect) mobileSortSelect.value = this.value;
        applySort(this.value);
      });
    }
    if (mobileSortSelect) {
      mobileSortSelect.addEventListener('change', function() {
        if (sortSelect) sortSelect.value = this.value;
        applySort(this.value);
      });
    }

    // Swatches Interactive State
    const swatches = document.querySelectorAll('.jt-swatch');
    swatches.forEach(swatch => {
      swatch.addEventListener('click', function() {
        const parent = this.closest('.jt-card-swatches');
        if (parent) {
          parent.querySelectorAll('.jt-swatch').forEach(s => s.classList.remove('jt-swatch--active'));
          this.classList.add('jt-swatch--active');
        }
      });
    });

    // Instant Add-to-Cart with toast notification & cart counter update
    const addBtns = document.querySelectorAll('.jt-add-cart-btn');
    const toast = document.getElementById('jt-toast');
    const toastMsg = document.getElementById('jt-toast-msg');

    addBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const title = this.getAttribute('data-product-title') || 'Hardware Item';
        const origText = this.innerHTML;
        this.innerHTML = '✓ Added to Cart';
        this.style.background = '#059669';
        this.style.color = '#ffffff';

        // Update cart bubbles if present
        const bubbles = document.querySelectorAll('.cart-count-bubble span');
        bubbles.forEach(bubble => {
          const cur = parseInt(bubble.textContent.trim()) || 0;
          bubble.textContent = cur + 1;
        });

        // Show toast
        if (toast && toastMsg) {
          toastMsg.textContent = '✓ ' + title + ' added to cart!';
          toast.classList.add('visible');
          setTimeout(() => {
            toast.classList.remove('visible');
          }, 2800);
        }

        setTimeout(() => {
          this.innerHTML = origText;
          this.style.background = '';
          this.style.color = '';
        }, 2000);
      });
    });
  });
</script>

