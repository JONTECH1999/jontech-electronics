<!-- Cart Added Notification Toast -->
<div id="jt-toast" class="jt-toast" role="alert" aria-live="polite">
  <span class="jt-toast-icon">✓</span>
  <span id="jt-toast-msg">Added to cart!</span>
</div>

<script>
  // Simple interactive filter tabs
  document.addEventListener('DOMContentLoaded', function() {
    const filterBtns = document.querySelectorAll('.jt-filter-btn');
    const cards = document.querySelectorAll('.jt-card');
    
    filterBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        filterBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        
        const filter = this.getAttribute('data-filter');
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-cat') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Instant Add-to-Cart with toast notification
    const addBtns = document.querySelectorAll('.jt-add-cart-btn');
    const toast = document.getElementById('jt-toast');
    const toastMsg = document.getElementById('jt-toast-msg');

    addBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const title = this.getAttribute('data-product-title') || 'Hardware Item';
        const origText = this.innerHTML;
        this.innerHTML = '✓ Added!';
        this.style.background = '#059669';
        this.style.color = '#fff';

        // Show toast
        if (toast && toastMsg) {
          toastMsg.textContent = '✓ ' + title + ' added to cart!';
          toast.classList.add('visible');
          setTimeout(() => {
            toast.classList.remove('visible');
          }, 2800);
        }

        setTimeout(() => {
          this.innerHTML = origText;
          this.style.background = '';
          this.style.color = '';
        }, 1800);
      });
    });
  });
</script>

