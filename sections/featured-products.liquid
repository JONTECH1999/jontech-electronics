{% comment %}
  JonTech Electronics - Featured Products & Bundles Section
{% endcomment %}

<section class="featured-products-section" style="padding: 5rem 0;" role="region" aria-label="Featured Products">
  <div class="container">
    <div class="section-header section-header--center">
      <h2 class="section-title">
        {{ section.settings.title | default: 'Featured Technology & Bundles' }}
      </h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Carefully selected and rigorously tested setups ready for immediate deployment.' }}
      </p>
    </div>

    {%- assign selected_collection = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.products_to_show | default: 8 -%}
    {%- assign product_list = selected_collection.products -%}
    {%- if product_list == blank or product_list.size == 0 -%}
      {%- assign product_list = collections.all.products -%}
    {%- endif -%}

    <div class="product-grid">
      {%- if product_list != blank and product_list.size > 0 -%}
        {%- for product in product_list limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Curated realistic JonTech Electronics bundles matching database & embedded app
        {%- endcomment -%}
        <!-- Bundle 1: ESP32 IoT Smart Weather & Telemetry Kit -->
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <a href="/products/esp32-nodemcu-devkit-v1" class="product-card__media-link" aria-label="ESP32 IoT Smart Weather & Telemetry Kit">
              <img
                src="https://images.unsplash.com/photo-1553406830-ef2513450d76?w=800&auto=format&fit=crop&q=80"
                alt="ESP32 IoT Smart Weather & Telemetry Kit"
                class="product-card__image"
                loading="lazy"
                width="600"
                height="600"
              >
            </a>
            <div class="product-card__badges">
              {% render 'badge', type: 'sale', text: 'SAVE 15%' %}
              {% render 'badge', type: 'bundle', text: 'KITFLOW #1 · 91.8 SCORE' %}
            </div>
          </div>
          <div class="product-card__content">
            <p class="product-card__vendor">JonTech Labs · IoT & Wireless</p>
            <h3 class="product-card__title">
              <a href="/products/esp32-nodemcu-devkit-v1" class="product-card__title-link">ESP32 IoT Smart Weather & Telemetry Kit</a>
            </h3>
            <div class="product-card__price">
              <div class="price-container price--on-sale">
                <span class="price-current">₱675.00</span>
                <s class="price-compare">₱795.00</s>
                <span class="price-badge-discount">Save 15%</span>
              </div>
            </div>
            <div class="product-card__actions">
              <a href="#lab-configurator" class="btn btn--secondary btn--sm btn--full">
                {% render 'icon', name: 'cart' %}
                <span>Configure Bundle (₱675.00)</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Bundle 2: Arduino Academic Robotics & Obstacle Avoidance Pack -->
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <a href="/products/arduino-uno-r3" class="product-card__media-link" aria-label="Arduino Academic Robotics & Obstacle Avoidance Pack">
              <img
                src="https://upload.wikimedia.org/wikipedia/commons/3/38/Arduino_Uno_-_R3.jpg"
                alt="Arduino Academic Robotics & Obstacle Avoidance Pack"
                class="product-card__image"
                loading="lazy"
                width="600"
                height="600"
              >
            </a>
            <div class="product-card__badges">
              {% render 'badge', type: 'sale', text: 'SAVE 12%' %}
              {% render 'badge', type: 'bundle', text: 'KITFLOW #2 · 92.0 SCORE' %}
            </div>
          </div>
          <div class="product-card__content">
            <p class="product-card__vendor">JonTech Robotics · STEM</p>
            <h3 class="product-card__title">
              <a href="/products/arduino-uno-r3" class="product-card__title-link">Arduino Academic Robotics & Obstacle Avoidance Pack</a>
            </h3>
            <div class="product-card__price">
              <div class="price-container price--on-sale">
                <span class="price-current">₱726.00</span>
                <s class="price-compare">₱825.00</s>
                <span class="price-badge-discount">Save 12%</span>
              </div>
            </div>
            <div class="product-card__actions">
              <a href="#lab-configurator" class="btn btn--secondary btn--sm btn--full">
                {% render 'icon', name: 'cart' %}
                <span>Configure Bundle (₱726.00)</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Bundle 3: Raspberry Pi 4 Edge AI & LiDAR Autonomous Lab -->
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <a href="/products/raspberry-pi-4-model-b-4gb" class="product-card__media-link" aria-label="Raspberry Pi 4 Edge AI & LiDAR Autonomous Lab">
              <img
                src="https://upload.wikimedia.org/wikipedia/commons/f/f1/Raspberry_Pi_4_Model_B_-_Side.jpg"
                alt="Raspberry Pi 4 Edge AI & LiDAR Autonomous Lab"
                class="product-card__image"
                loading="lazy"
                width="600"
                height="600"
              >
            </a>
            <div class="product-card__badges">
              {% render 'badge', type: 'sale', text: 'SAVE 10%' %}
              {% render 'badge', type: 'bundle', text: 'KITFLOW #3 · 77.3 SCORE' %}
            </div>
          </div>
          <div class="product-card__content">
            <p class="product-card__vendor">JonTech Linux · Edge AI</p>
            <h3 class="product-card__title">
              <a href="/products/raspberry-pi-4-model-b-4gb" class="product-card__title-link">Raspberry Pi 4 Edge AI & LiDAR Autonomous Lab</a>
            </h3>
            <div class="product-card__price">
              <div class="price-container price--on-sale">
                <span class="price-current">₱5,304.00</span>
                <s class="price-compare">₱5,894.00</s>
                <span class="price-badge-discount">Save 10%</span>
              </div>
            </div>
            <div class="product-card__actions">
              <a href="#lab-configurator" class="btn btn--secondary btn--sm btn--full">
                {% render 'icon', name: 'cart' %}
                <span>Configure Bundle (₱5,304.00)</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Bundle 4: STM32 Industrial Automation & Relay Control Rig -->
        <article class="product-card">
          <div class="product-card__image-wrapper">
            <a href="/products/stm32f401-black-pill" class="product-card__media-link" aria-label="STM32 Industrial Automation & Relay Control Rig">
              <img
                src="https://images.unsplash.com/photo-1608564697071-ddf911d81370?w=800&auto=format&fit=crop&q=80"
                alt="STM32 Industrial Automation & Relay Control Rig"
                class="product-card__image"
                loading="lazy"
                width="600"
                height="600"
              >
            </a>
            <div class="product-card__badges">
              {% render 'badge', type: 'sale', text: 'SAVE 14%' %}
              {% render 'badge', type: 'bundle', text: 'KITFLOW #4 · 87.8 SCORE' %}
            </div>
          </div>
          <div class="product-card__content">
            <p class="product-card__vendor">JonTech Industrial · Embedded</p>
            <h3 class="product-card__title">
              <a href="/products/stm32f401-black-pill" class="product-card__title-link">STM32 Industrial Automation & Relay Control Rig</a>
            </h3>
            <div class="product-card__price">
              <div class="price-container price--on-sale">
                <span class="price-current">₱499.00</span>
                <s class="price-compare">₱580.00</s>
                <span class="price-badge-discount">Save 14%</span>
              </div>
            </div>
            <div class="product-card__actions">
              <a href="#lab-configurator" class="btn btn--secondary btn--sm btn--full">
                {% render 'icon', name: 'cart' %}
                <span>Configure Bundle (₱499.00)</span>
              </a>
            </div>
          </div>
        </article>
      {%- endif -%}
    </div>

    <div style="text-align: center; margin-top: 3.5rem;">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline btn--lg">
        View All Equipment & Kits
        {% render 'icon', name: 'chevron-right' %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Featured Technology & Bundles"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Carefully selected and rigorously tested setups ready for immediate deployment."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
