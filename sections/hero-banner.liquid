{% comment %}
  JonTech Electronics - Hero Banner Section
  Fully configurable via theme schema
{% endcomment %}

<section class="hero-section text-{{ section.settings.alignment }}" role="region" aria-label="Hero Banner">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          {% render 'badge', type: 'bundle', text: section.settings.badge_text | default: 'EMBEDDED SYSTEMS & PROTOTYPING' %}
        </div>

        <h1 class="hero-title">
          {{ section.settings.headline | default: 'Prototyping technology that fits the way you build.' }}
        </h1>

        <p class="hero-subtext">
          {{ section.settings.subtext | default: 'Curated development boards (ESP32, Arduino, STM32, Raspberry Pi), precision sensors (DHT22, Ultrasonic, LiDAR), robotics drivers, and student lab kits.' }}
        </p>

        <div class="hero-cta-group">
          <a href="{{ section.settings.primary_cta_url | default: '/collections/all' }}" class="btn btn--primary btn--lg">
            {{ section.settings.primary_cta_text | default: 'Explore Electronics' }}
            {% render 'icon', name: 'chevron-right' %}
          </a>

          <a href="{{ section.settings.secondary_cta_url | default: '#build-my-setup' }}" class="btn btn--secondary btn--lg">
            {{ section.settings.secondary_cta_text | default: 'Build My Project Kit' }}
            {% render 'icon', name: 'zap' %}
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-card-preview">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              {% render 'icon', name: 'cpu', class: 'text-primary' %}
              <span style="font-weight: 700; color: #fff; font-size: 1.125rem;">Curated Prototyping Kit</span>
            </div>
            {% render 'badge', type: 'sale', text: 'VERIFIED KIT' %}
          </div>

          <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin-bottom: 1.25rem;">
            Every electronic kit is mathematically scored and bench-tested for voltage logic levels (3.3V/5V), pin compatibility, and zero-conflict I2C/UART bus routing.
          </p>

          <div style="background: var(--color-bg); border-radius: var(--radius-md); padding: 1rem; border: 1px solid var(--color-border); margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 0.5rem;">
              <span style="color: var(--color-text-muted);">Voltage & Pin Synergy</span>
              <span style="color: var(--color-sale); font-weight: 700;">100% Bench Verified</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 0.5rem;">
              <span style="color: var(--color-text-muted);">Average Student Savings</span>
              <span style="color: var(--color-primary); font-weight: 700;">12% – 15% off bundle</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.875rem;">
              <span style="color: var(--color-text-muted);">Dispatch Status</span>
              <span style="color: #fff; font-weight: 600;">Immediate Warehouse Stock</span>
            </div>
          </div>

          <div class="hero-stats-row">
            <div class="hero-stat-item">
              <h4>99.4%</h4>
              <p>Setup Satisfaction</p>
            </div>
            <div class="hero-stat-item">
              <h4>0ms</h4>
              <p>Wireless Latency</p>
            </div>
            <div class="hero-stat-item">
              <h4>2-Yr</h4>
              <p>Warranty Care</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "JONTECH CURATED WORKSPACES 2026"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Technology that fits the way you live."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Supporting Text",
      "default": "Curated workspace gear, gaming essentials, and mobile workstation setups engineered for peak productivity and performance."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Label",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Label",
      "default": "Build My Setup"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA Link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
