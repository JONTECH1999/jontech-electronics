{% comment %}
  JonTech Electronics - Hero Banner Section
  Warm Linen & Beige Aesthetic with Ambient Amber Aura
{% endcomment %}

<section class="hero-section text-{{ section.settings.alignment | default: 'left' }}" role="region" aria-label="Hero Banner">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          {% render 'badge', type: 'bundle', text: section.settings.badge_text | default: 'BENCH-TESTED EMBEDDED HARDWARE 2026' %}
        </div>

        <h1 class="hero-title">
          {{ section.settings.headline | default: 'Prototyping technology engineered for real labs & universities.' }}
        </h1>

        <p class="hero-subtext">
          {{ section.settings.subtext | default: 'Curated microcontrollers (ESP32, Arduino, Raspberry Pi, STM32), calibrated precision sensors (DHT22, Sonar, LiDAR), motor drivers, and verified STEM kits with zero pinout conflicts.' }}
        </p>

        <div class="hero-cta-group">
          <a href="{{ section.settings.primary_cta_url | default: '/collections/all' }}" class="btn btn--primary btn--lg">
            {{ section.settings.primary_cta_text | default: 'Explore Hardware Catalog' }}
            {% render 'icon', name: 'chevron-right' %}
          </a>

          <a href="{{ section.settings.secondary_cta_url | default: '#lab-configurator' }}" class="btn btn--secondary btn--lg">
            {{ section.settings.secondary_cta_text | default: 'Build My Custom Kit' }}
            {% render 'icon', name: 'zap' %}
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-card-preview">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <span style="color: var(--color-primary);">{% render 'icon', name: 'cpu' %}</span>
              <span style="font-weight: 800; color: var(--color-heading); font-size: 1.15rem;">Featured Prototyping Kit</span>
            </div>
            {% render 'badge', type: 'sale', text: 'BENCH VERIFIED' %}
          </div>

          <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin-bottom: 1.5rem; line-height: 1.55;">
            Every electronic kit is mathematically scored and bench-tested for voltage logic levels (3.3V/5V), header pin alignment, and zero-conflict I2C/UART bus routing.
          </p>

          <div style="background: var(--color-bg); border-radius: var(--radius-md); padding: 1.25rem; border: 1px solid var(--color-border); margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 0.6rem;">
              <span style="color: var(--color-text-muted);">Voltage & Pin Synergy</span>
              <span style="color: var(--color-sale); font-weight: 700;">100% Bench Verified (Safe)</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.875rem; margin-bottom: 0.6rem;">
              <span style="color: var(--color-text-muted);">Average Maker Savings</span>
              <span style="color: var(--color-primary); font-weight: 700;">12% – 15% Bundle Discount</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.875rem;">
              <span style="color: var(--color-text-muted);">Warehouse Dispatch</span>
              <span style="color: var(--color-heading); font-weight: 700;">Manila Courier Ready</span>
            </div>
          </div>

          <div class="hero-stats-row">
            <div class="hero-stat-item">
              <h4>100%</h4>
              <p>Logic Level Safe</p>
            </div>
            <div class="hero-stat-item">
              <h4>2-Year</h4>
              <p>Direct Swap Warranty</p>
            </div>
            <div class="hero-stat-item">
              <h4>Same-Day</h4>
              <p>Courier Dispatch</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "BENCH-TESTED EMBEDDED HARDWARE 2026"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Prototyping technology engineered for real labs & universities."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Curated microcontrollers (ESP32, Arduino, Raspberry Pi, STM32), calibrated precision sensors (DHT22, Sonar, LiDAR), motor drivers, and verified STEM kits with zero pinout conflicts."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Explore Hardware Catalog"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Build My Custom Kit"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA Link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
