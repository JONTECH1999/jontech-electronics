{% comment %}
  JonTech Electronics - Interactive Hardware Lab & Bundle Configurator
  Standout Creative Interactive Feature with Eye-Catching Product Photography
{% endcomment %}

<section id="lab-configurator" class="lab-configurator-section" role="region" aria-label="Interactive Hardware Lab Configurator">
  <div class="container">
    <div class="section-header section-header--center">
      <div style="margin-bottom: 0.75rem;">
        <span class="jt-badge jt-badge--deal">STANDOUT INTERACTIVE FEATURE</span>
      </div>
      <h2 class="section-title">
        {{ section.settings.title | default: 'Interactive Hardware Lab & Kit Configurator' }}
      </h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Design your custom maker setup. Pick a microcontroller, attach telemetry sensors, configure motor or relay switching, and watch voltage logic safety and bundle savings calculate in real time.' }}
      </p>
    </div>

    <div class="configurator-wrapper" data-lab-configurator>
      <!-- Step Navigation Tabs -->
      <div class="configurator-nav-steps">
        <button type="button" class="cfg-step-tab active" data-cfg-tab="step-1">
          <span class="cfg-step-num">1</span>
          <span>{{ section.settings.step_1_tab | default: 'Core Microcontroller' }}</span>
        </button>
        <button type="button" class="cfg-step-tab" data-cfg-tab="step-2">
          <span class="cfg-step-num">2</span>
          <span>{{ section.settings.step_2_tab | default: 'Telemetry & Sensors' }}</span>
        </button>
        <button type="button" class="cfg-step-tab" data-cfg-tab="step-3">
          <span class="cfg-step-num">3</span>
          <span>{{ section.settings.step_3_tab | default: 'Actuation & Prototyping' }}</span>
        </button>
      </div>

      <!-- Step 1: Core MCU Selection -->
      <div class="cfg-step-content active" data-cfg-step="step-1">
        <div style="margin-bottom: 1.25rem;">
          <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem;">
            {{ section.settings.step_1_title | default: 'Step 1: Choose Your Main Compute Core' }}
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted);">
            {{ section.settings.step_1_subtitle | default: 'Select the microcontroller or single-board computer brain for your project.' }}
          </p>
        </div>

        <div class="cfg-grid-options">
          {% for block in section.blocks %}
            {% if block.settings.group == 'step-1' %}
              <div
                class="cfg-option-card {% if block.settings.default_selected %}selected{% endif %}"
                data-mcu="{{ block.id }}"
                data-price="{{ block.settings.price | plus: 0 }}"
                data-voltage="{{ block.settings.voltage | escape }}"
                data-name="{{ block.settings.title | escape }}"
                data-sku="{{ block.settings.sku | escape }}"
                {{ block.shopify_attributes }}
              >
                <div class="cfg-option-media">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.title | escape }}"
                      class="cfg-option-img"
                      width="400"
                      height="300"
                      loading="lazy"
                    >
                  {% else %}
                    <img src="https://images.unsplash.com/photo-1553406830-ef2513450d76?w=400&auto=format&fit=crop&q=80" alt="Option image" class="cfg-option-img" width="400" height="300" loading="lazy">
                  {% endif %}

                  {% if block.settings.badge != blank %}
                    <span class="cfg-badge-mcu">{{ block.settings.badge }}</span>
                  {% endif %}
                </div>

                <div class="cfg-option-header">
                  <span class="cfg-option-title">{{ block.settings.title | default: 'Option Title' }}</span>
                  <span class="cfg-option-price">{{ block.settings.price | money }}</span>
                </div>

                <p class="cfg-option-desc">{{ block.settings.description | default: 'Add a description for this option.' }}</p>

                <div class="cfg-option-specs">
                  {% if block.settings.spec_1 != blank %}
                    <span class="cfg-spec-pill">{{ block.settings.spec_1 }}</span>
                  {% endif %}
                  {% if block.settings.spec_2 != blank %}
                    <span class="cfg-spec-pill">{{ block.settings.spec_2 }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">
          <button type="button" class="btn btn--primary" data-cfg-next="step-2">
            {{ section.settings.step_1_cta | default: 'Proceed to Sensors →' }}
          </button>
        </div>
      </div>

      <!-- Step 2: Sensors & Telemetry -->
      <div class="cfg-step-content" data-cfg-step="step-2">
        <div style="margin-bottom: 1.25rem;">
          <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem;">
            {{ section.settings.step_2_title | default: 'Step 2: Add Sensing & Telemetry Modules' }}
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted);">
            {{ section.settings.step_2_subtitle | default: 'Select the telemetry inputs for your environment (toggle any on/off).' }}
          </p>
        </div>

        <div class="cfg-grid-options">
          {% for block in section.blocks %}
            {% if block.settings.group == 'step-2' %}
              <div
                class="cfg-option-card {% if block.settings.default_selected %}selected{% endif %}"
                data-component="{{ block.id }}"
                data-price="{{ block.settings.price | plus: 0 }}"
                data-name="{{ block.settings.title | escape }}"
                data-sku="{{ block.settings.sku | escape }}"
                {{ block.shopify_attributes }}
              >
                <div class="cfg-option-media">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.title | escape }}"
                      class="cfg-option-img"
                      width="400"
                      height="300"
                      loading="lazy"
                    >
                  {% else %}
                    <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?w=400&auto=format&fit=crop&q=80" alt="Option image" class="cfg-option-img" width="400" height="300" loading="lazy">
                  {% endif %}

                  {% if block.settings.badge != blank %}
                    <span class="cfg-badge-mcu">{{ block.settings.badge }}</span>
                  {% endif %}
                </div>

                <div class="cfg-option-header">
                  <span class="cfg-option-title">{{ block.settings.title | default: 'Option Title' }}</span>
                  <span class="cfg-option-price">+{{ block.settings.price | money }}</span>
                </div>

                <p class="cfg-option-desc">{{ block.settings.description | default: 'Add a description for this option.' }}</p>

                <div class="cfg-option-specs">
                  {% if block.settings.spec_1 != blank %}
                    <span class="cfg-spec-pill">{{ block.settings.spec_1 }}</span>
                  {% endif %}
                  {% if block.settings.spec_2 != blank %}
                    <span class="cfg-spec-pill">{{ block.settings.spec_2 }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
          <button type="button" class="btn btn--outline" data-cfg-prev="step-1">
            {{ section.settings.step_2_back | default: '← Back to MCU' }}
          </button>
          <button type="button" class="btn btn--primary" data-cfg-next="step-3">
            {{ section.settings.step_2_cta | default: 'Proceed to Actuators →' }}
          </button>
        </div>
      </div>

      <!-- Step 3: Actuation & Prototyping -->
      <div class="cfg-step-content" data-cfg-step="step-3">
        <div style="margin-bottom: 1.25rem;">
          <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem;">
            {{ section.settings.step_3_title | default: 'Step 3: Add Actuation, Switching & Breadboard Gear' }}
          </h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted);">
            {{ section.settings.step_3_subtitle | default: 'Choose power relays, motor controllers, servo steering, or breadboard wires.' }}
          </p>
        </div>

        <div class="cfg-grid-options">
          {% for block in section.blocks %}
            {% if block.settings.group == 'step-3' %}
              <div
                class="cfg-option-card {% if block.settings.default_selected %}selected{% endif %}"
                data-component="{{ block.id }}"
                data-price="{{ block.settings.price | plus: 0 }}"
                data-name="{{ block.settings.title | escape }}"
                data-sku="{{ block.settings.sku | escape }}"
                {{ block.shopify_attributes }}
              >
                <div class="cfg-option-media">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.title | escape }}"
                      class="cfg-option-img"
                      width="400"
                      height="300"
                      loading="lazy"
                    >
                  {% else %}
                    <img src="https://images.unsplash.com/photo-1555664424-778a1e5e1b48?w=400&auto=format&fit=crop&q=80" alt="Option image" class="cfg-option-img" width="400" height="300" loading="lazy">
                  {% endif %}

                  {% if block.settings.badge != blank %}
                    <span class="cfg-badge-mcu">{{ block.settings.badge }}</span>
                  {% endif %}
                </div>

                <div class="cfg-option-header">
                  <span class="cfg-option-title">{{ block.settings.title | default: 'Option Title' }}</span>
                  <span class="cfg-option-price">+{{ block.settings.price | money }}</span>
                </div>

                <p class="cfg-option-desc">{{ block.settings.description | default: 'Add a description for this option.' }}</p>

                <div class="cfg-option-specs">
                  {% if block.settings.spec_1 != blank %}
                    <span class="cfg-spec-pill">{{ block.settings.spec_1 }}</span>
                  {% endif %}
                  {% if block.settings.spec_2 != blank %}
                    <span class="cfg-spec-pill">{{ block.settings.spec_2 }}</span>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div style="display: flex; justify-content: flex-start; margin-top: 1.5rem;">
          <button type="button" class="btn btn--outline" data-cfg-prev="step-2">
            {{ section.settings.step_3_back | default: '← Back to Sensors' }}
          </button>
        </div>
      </div>

      <!-- Live Summary & Voltage Synergy Console -->
      <div class="cfg-summary-console">
        <div class="cfg-console-header">
          <div>
            <h4 style="font-size: 1.125rem; font-weight: 700; color: #1c1917; margin-bottom: 0.25rem;">
              {{ section.settings.summary_title | default: 'Hardware Configuration & Synergy Analysis' }}
            </h4>
            <span style="font-size: 0.8125rem; color: var(--color-text-muted);">
              {{ section.settings.summary_subtitle | default: 'Deterministic KitFlow verification engine running in real time.' }}
            </span>
          </div>
          <div class="cfg-score-badge">
            <span class="cfg-score-label">{{ section.settings.score_label | default: 'KitFlow Synergy' }}</span>
            <span class="cfg-score-val" data-cfg-score>96%</span>
          </div>
        </div>

        <!-- Voltage & Logic Rail Monitor -->
        <div class="cfg-voltage-monitor" data-cfg-voltage-status="safe">
          <div class="cfg-v-status-icon">✓</div>
          <div>
            <strong data-cfg-v-title>{{ section.settings.voltage_title | default: 'Voltage Rails Synchronous (3.3V Logic Safe)' }}</strong>
            <p data-cfg-v-desc style="margin: 0; font-size: 0.8125rem; color: var(--color-text-muted);">
              {{ section.settings.voltage_description | default: 'ESP32 operates at 3.3V logic. I2C OLED and DHT22 are fully voltage-tolerant without level-shifter needed.' }}
            </p>
          </div>
        </div>

        <!-- Selected Components Chips -->
        <div style="margin-bottom: 1rem;">
          <span style="font-size: 0.8125rem; font-weight: 600; color: var(--color-text-muted); display: block; margin-bottom: 0.5rem;">
            {{ section.settings.selected_label | default: 'Selected Lab Components:' }}
          </span>
          <div class="cfg-selected-chips" data-cfg-chips>
            <!-- Rendered dynamically by JS -->
          </div>
        </div>

        <!-- Pricing & Add to Cart -->
        <div class="cfg-checkout-row">
          <div class="cfg-pricing">
            <div style="display: flex; align-items: baseline; gap: 0.75rem;">
              <span class="cfg-final-price" data-cfg-total>₱676.00</span>
              <span class="cfg-original-price" data-cfg-original>₱795.00</span>
            </div>
            <span class="cfg-discount-badge" data-cfg-savings>You Save ₱119.00 (15% Bundle Discount)</span>
          </div>

          <button type="button" class="btn btn--amazon btn--lg" data-cfg-add-cart>
            {{ section.settings.add_to_cart_label | default: 'Add Complete Lab Kit to Cart' }}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'lab-configurator.js' | asset_url }}" defer="defer"></script>

