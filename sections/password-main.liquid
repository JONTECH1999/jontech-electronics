{% comment %}
  JonTech Electronics - Password Gate Section
{% endcomment %}

<div class="container" style="min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 4rem 1rem;">
  <div style="max-width: 540px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 3rem 2rem; box-shadow: var(--shadow-md);">
    <div style="margin-bottom: 1.5rem; display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius-full); background: rgba(180, 83, 9, 0.1); color: var(--color-primary);">
      {% render 'icon', name: 'cpu' %}
    </div>
    <h1 style="font-size: 1.875rem; font-weight: 800; color: var(--color-heading); margin-bottom: 0.75rem;">
      {{ shop.name | default: 'JonTech Electronics' }}
    </h1>
    <p style="color: var(--color-text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
      Store is launching soon. Bench-tested microcontrollers, precision sensors, and robotics modules.
    </p>

    {%- if shop.password_message != blank -%}
      <p style="margin-bottom: 1.5rem; color: var(--color-text); font-size: 0.9375rem;">{{ shop.password_message }}</p>
    {%- endif -%}

    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div style="display: flex; gap: 0.5rem; flex-direction: column;">
        <label for="Password" style="font-size: 0.8125rem; font-weight: 600; text-align: left; color: var(--color-text);">Enter Store Password</label>
        <div style="display: flex; gap: 0.5rem;">
          <input
            type="password"
            name="password"
            id="Password"
            class="input"
            style="flex: 1; padding: 0.75rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-bg);"
            placeholder="Password"
            autocomplete="current-password"
          >
          <button type="submit" class="btn btn--primary" style="padding: 0.75rem 1.5rem; border-radius: var(--radius-md);">
            Enter
          </button>
        </div>
      </div>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password Gate",
  "settings": []
}
{% endschema %}
