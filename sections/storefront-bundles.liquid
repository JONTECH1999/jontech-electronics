<section
  class="jt-storefront-bundles"
  data-bundles-section
  data-bundle-backend="{{ section.settings.backend_url | default: 'https://grandmotherly-mitchel-eternal.ngrok-free.dev' | strip_html | escape }}"
  data-bundle-endpoint="{{ section.settings.endpoint | default: '/api/bundles' | strip_html | escape }}"
>
  <div class="page-width">
    <h2 style="font-size: 2rem; margin-bottom: 1rem;">{{ section.settings.heading | default: 'Bundles' }}</h2>
    <div id="bundle-list" aria-live="polite" style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));"></div>
  </div>
</section>

<script>
  async function loadBundles() {
    const section = document.querySelector('[data-bundles-section]');
    if (!section) return;

    const bundleList = section.querySelector('#bundle-list');
    const backendBase = (section.dataset.bundleBackend || '').replace(/\/+$/, '');
    const endpoint = (section.dataset.bundleEndpoint || '/api/bundles').replace(/^\/+/, '/');
    const apiUrl = backendBase ? `${backendBase}${endpoint}` : endpoint;

    if (!bundleList) return;

    try {
      const response = await fetch(apiUrl, {
        method: 'GET',
        headers: {
          'Accept': 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error(`Failed to fetch bundles (${response.status})`);
      }

      const data = await response.json();
      const bundles = Array.isArray(data.bundles) ? data.bundles : [];

      if (!bundles.length) {
        bundleList.innerHTML = '<p>No bundles available right now.</p>';
        return;
      }

      bundleList.innerHTML = bundles.map(bundle => {
        const items = Array.isArray(bundle.items) ? bundle.items : [];
        const itemText = items.length
          ? items.map(item => item.productTitle || item.title || 'Bundle item').join(', ')
          : 'No items listed';

        return `
          <div style="
            border: 1px solid #ddd;
            border-radius: 12px;
            padding: 1rem;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
          ">
            <h3 style="margin: 0 0 0.5rem;">${bundle.name || 'Bundle'}</h3>
            <p style="margin: 0 0 0.5rem; color: #555;">${bundle.description || 'No description'}</p>
            <p style="margin: 0; font-weight: 700;">
              Discount: ${bundle.discountPercent ?? 0}%
            </p>
            <p style="margin: 0.35rem 0 0; color: #666;">
              Items: ${items.length}
            </p>
            <p style="margin: 0.5rem 0 0; color: #666; font-size: 0.9rem;">
              ${itemText}
            </p>
          </div>
        `;
      }).join('');
    } catch (error) {
      console.error('Bundle load failed:', error);
      bundleList.innerHTML = `
        <p>Unable to load bundles right now.</p>
        <p style="color: #666; font-size: 0.9rem;">Check the backend URL in the section settings.</p>
      `;
    }
  }

  document.addEventListener('DOMContentLoaded', loadBundles);
</script>

{% schema %}
{
  "name": "Bundles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Bundles"
    },
    {
      "type": "text",
      "id": "backend_url",
      "label": "Backend base URL",
      "default": "https://grandmotherly-mitchel-eternal.ngrok-free.dev",
      "info": "Use your live public backend URL, for example: https://your-backend-url.com"
    },
    {
      "type": "text",
      "id": "endpoint",
      "label": "API endpoint",
      "default": "/api/bundles",
      "info": "Leave this as /api/bundles unless your backend uses a different route."
    }
  ],
  "presets": [
    {
      "name": "Bundles"
    }
  ]
}
{% endschema %}
