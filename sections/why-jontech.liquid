{% comment %}
  JonTech Electronics - Why JonTech Section
  Warm Linen & Beige Aesthetic with Electronics & Engineering Focus
{% endcomment %}

<section id="why-jontech" class="why-jontech-section" style="padding: 5rem 0; border-top: 1px solid var(--color-border);" role="region" aria-label="Why JonTech">
  <div class="container">
    <div class="section-header section-header--center">
      <div style="margin-bottom: 0.75rem;">
        {% render 'badge', type: 'sale', text: 'ENGINEERING EXCELLENCE' %}
      </div>
      <h2 class="section-title">
        {{ section.settings.title | default: 'Why Choose JonTech Electronics?' }}
      </h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Hardware standards backed by automated voltage verification, pinout synergy, and Filipino engineering support.' }}
      </p>
    </div>

    <div class="why-grid">
      <!-- Item 1 -->
      <div class="why-item">
        <div class="why-icon-box">
          {% render 'icon', name: 'shield' %}
        </div>
        <h3 class="why-title">{{ section.settings.item1_title | default: 'Lab-Bench Verified' }}</h3>
        <p class="why-desc">{{ section.settings.item1_desc | default: 'Every microcontroller, sensor, and relay is bench-tested for 3.3V/5V voltage logic, pin alignment, and pull-up resistor integrity. Zero defective boards.' }}</p>
      </div>

      <!-- Item 2 -->
      <div class="why-item">
        <div class="why-icon-box">
          {% render 'icon', name: 'zap' %}
        </div>
        <h3 class="why-title">{{ section.settings.item2_title | default: 'Verified Hardware Kits' }}</h3>
        <p class="why-desc">{{ section.settings.item2_desc | default: 'Cohesive STEM and university packs configured with zero GPIO collisions, working sample code, and built-in bundle savings up to 15%.' }}</p>
      </div>

      <!-- Item 3 -->
      <div class="why-item">
        <div class="why-icon-box">
          {% render 'icon', name: 'truck' %}
        </div>
        <h3 class="why-title">{{ section.settings.item3_title | default: 'Local Engineering Support' }}</h3>
        <p class="why-desc">{{ section.settings.item3_desc | default: 'Direct assistance from Manila engineers who actually understand I2C addressing, ADC attenuation, PWM frequencies, and CircuitPython.' }}</p>
      </div>

      <!-- Item 4 -->
      <div class="why-item">
        <div class="why-icon-box">
          {% render 'icon', name: 'cpu' %}
        </div>
        <h3 class="why-title">{{ section.settings.item4_title | default: '2-Year Direct Warranty' }}</h3>
        <p class="why-desc">{{ section.settings.item4_desc | default: 'Comprehensive replacement warranty on all kits and dev boards with express courier swap dispatch across the Philippines.' }}</p>
      </div>
    </div>
  </div>
</section>

