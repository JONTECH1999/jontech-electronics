<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ shop.name | default: 'JonTech Electronics' }} &ndash; Coming Soon</title>

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    {{ content_for_header }}
  </head>

  <body class="template-password theme-linen" style="background-color: var(--color-bg); min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <main id="MainContent" class="content-for-layout focus-none" role="main" style="width: 100%;">
      {{ content_for_layout }}
    </main>
  </body>
</html>
