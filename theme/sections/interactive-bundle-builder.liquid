{% comment %}
  JonTech Electronics - Interactive Hardware Lab & Bundle Configurator
  Standout Creative Interactive Feature (Custom Section #3)
  Real-time voltage logic compatibility, deterministic scoring, live ₱ pricing, and 1-click cart addition.
{% endcomment %}

<section id="lab-configurator" class="lab-configurator-section" role="region" aria-label="Interactive Hardware Lab Configurator">
  <div class="container">
    <div class="section-header section-header--center">
      <div style="margin-bottom: 0.75rem;">
        {% render 'badge', type: 'bundle', text: 'STANDOUT INTERACTIVE FEATURE' %}
      </div>
      <h2 class="section-title">
        {{ section.settings.title | default: 'Interactive Hardware Lab & Kit Configurator' }}
      </h2>
      <p class="section-subtitle">
        {{ section.settings.subtitle | default: 'Design your custom maker setup. Pick a microcontroller, attach telemetry sensors, configure motor or relay switching, and watch voltage logic safety and bundle savings calculate in real time.' }}
      </p>
    </div>

    <div class="configurator-wrapper" data-lab-configurator>
      <!-- Step Navigation Tabs -->
      <div class="configurator-nav-steps">
        <button type="button" class="cfg-step-tab active" data-cfg-tab="step-1">
          <span class="cfg-step-num">1</span>
          <span>Core Microcontroller</span>
        </button>
        <button type="button" class="cfg-step-tab" data-cfg-tab="step-2">
          <span class="cfg-step-num">2</span>
          <span>Telemetry & Sensors</span>
        </button>
        <button type="button" class="cfg-step-tab" data-cfg-tab="step-3">
          <span class="cfg-step-num">3</span>
          <span>Actuation & Prototyping</span>
        </button>
      </div>

      <!-- Step 1: Core MCU Selection -->
      <div class="cfg-step-content active" data-cfg-step="step-1">
        <div style="margin-bottom: 1.25rem;">
          <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Step 1: Choose Your Main Compute Core</h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted);">Select the microcontroller or single-board computer brain for your project.</p>
        </div>

        <div class="cfg-grid-options">
          <!-- ESP32 -->
          <div class="cfg-option-card selected" data-mcu="esp32" data-price="280" data-voltage="3.3V" data-name="ESP32 NodeMCU DevKit v1 (30-Pin WiFi+BLE)" data-sku="JT-MCU-ESP32-30P">
            <div class="cfg-option-header">
              <span class="cfg-option-title">ESP32 NodeMCU DevKit v1</span>
              <span class="cfg-option-price">₱280.00</span>
            </div>
            <p class="cfg-option-desc">240MHz dual-core Tensilica with built-in 802.11 b/g/n Wi-Fi and Bluetooth v4.2 BLE. Ideal for cloud IoT.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">3.3V Logic</span>
              <span class="cfg-spec-pill">WiFi + BLE</span>
              <span class="cfg-spec-pill">30-Pin USB-C</span>
            </div>
          </div>

          <!-- Arduino Uno R3 -->
          <div class="cfg-option-card" data-mcu="arduino" data-price="350" data-voltage="5V" data-name="Arduino Uno R3 (ATmega328P + CH340G)" data-sku="JT-MCU-UNO-R3">
            <div class="cfg-option-header">
              <span class="cfg-option-title">Arduino Uno R3 ATmega328P</span>
              <span class="cfg-option-price">₱350.00</span>
            </div>
            <p class="cfg-option-desc">Standard academic platform for electronics education, school prototyping, robotics, and beginner STEM.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">5V Logic Safe</span>
              <span class="cfg-spec-pill">16MHz Crystal</span>
              <span class="cfg-spec-pill">14 Digital I/O</span>
            </div>
          </div>

          <!-- Raspberry Pi 4 -->
          <div class="cfg-option-card" data-mcu="rpi4" data-price="3899" data-voltage="3.3V" data-name="Raspberry Pi 4 Model B (4GB RAM)" data-sku="JT-SBC-RPI4-4GB">
            <div class="cfg-option-header">
              <span class="cfg-option-title">Raspberry Pi 4 (4GB RAM)</span>
              <span class="cfg-option-price">₱3,899.00</span>
            </div>
            <p class="cfg-option-desc">High-compute 64-bit quad-core Linux computer. Exceptional for local OpenCV AI and LiDAR SLAM navigation.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">64-bit Linux</span>
              <span class="cfg-spec-pill">4GB LPDDR4</span>
              <span class="cfg-spec-pill">Dual 4K HDMI</span>
            </div>
          </div>

          <!-- STM32 Black Pill -->
          <div class="cfg-option-card" data-mcu="stm32" data-price="240" data-voltage="3.3V" data-name="STM32F401 Black Pill ARM Cortex-M4" data-sku="JT-MCU-STM32-F401">
            <div class="cfg-option-header">
              <span class="cfg-option-title">STM32F401 "Black Pill"</span>
              <span class="cfg-option-price">₱240.00</span>
            </div>
            <p class="cfg-option-desc">84MHz 32-bit ARM Cortex-M4 with hardware FPU. Built for high-speed industrial feedback loops and signal filters.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">84MHz M4 Core</span>
              <span class="cfg-spec-pill">256KB Flash</span>
              <span class="cfg-spec-pill">Type-C Native</span>
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end;">
          <button type="button" class="btn btn--primary" data-cfg-next="step-2">
            Proceed to Sensors
            {% render 'icon', name: 'chevron-right' %}
          </button>
        </div>
      </div>

      <!-- Step 2: Sensors & Telemetry -->
      <div class="cfg-step-content" data-cfg-step="step-2">
        <div style="margin-bottom: 1.25rem;">
          <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Step 2: Add Sensing & Telemetry Modules</h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted);">Select the telemetry inputs for your environment (toggle any on/off).</p>
        </div>

        <div class="cfg-grid-options">
          <!-- DHT22 -->
          <div class="cfg-option-card selected" data-component="sensor-dht22" data-price="195" data-name="DHT22 Digital Temperature & Humidity Sensor" data-sku="JT-SEN-DHT22-MOD">
            <div class="cfg-option-header">
              <span class="cfg-option-title">DHT22 Temp & Humidity Sensor</span>
              <span class="cfg-option-price">+₱195.00</span>
            </div>
            <p class="cfg-option-desc">Calibrated digital 1-wire output. Relative humidity 0-100% and temperature -40 to 80°C with pre-soldered pull-up.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">1-Wire Digital</span>
              <span class="cfg-spec-pill">±0.5°C Accuracy</span>
            </div>
          </div>

          <!-- 0.96" OLED -->
          <div class="cfg-option-card selected" data-component="sensor-oled" data-price="145" data-name="0.96 inch I2C OLED Display (128x64)" data-sku="JT-DSP-OLED096-I2C">
            <div class="cfg-option-header">
              <span class="cfg-option-title">0.96" I2C OLED Display (128x64)</span>
              <span class="cfg-option-price">+₱145.00</span>
            </div>
            <p class="cfg-option-desc">High contrast graphical readout. Standard 4-pin I2C interface (SDA/SCL) for immediate telemetry visualization.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">I2C (0x3C)</span>
              <span class="cfg-spec-pill">Self-Emitting</span>
            </div>
          </div>

          <!-- HC-SR04 -->
          <div class="cfg-option-card" data-component="sensor-ultrasonic" data-price="85" data-name="HC-SR04 Ultrasonic Distance Sensor" data-sku="JT-SEN-HCSR04-5V">
            <div class="cfg-option-header">
              <span class="cfg-option-title">HC-SR04 Ultrasonic Rangefinder</span>
              <span class="cfg-option-price">+₱85.00</span>
            </div>
            <p class="cfg-option-desc">Non-contact 2cm to 400cm sonar transducer with 3mm resolution. Essential for obstacle avoidance rovers.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">2cm - 400cm</span>
              <span class="cfg-spec-pill">Echo Sonar</span>
            </div>
          </div>

          <!-- TFmini-S LiDAR -->
          <div class="cfg-option-card" data-component="sensor-lidar" data-price="1850" data-name="TFmini-S Micro Solid-State LiDAR Sensor" data-sku="JT-SEN-TFMINIS-12M">
            <div class="cfg-option-header">
              <span class="cfg-option-title">TFmini-S ToF Solid-State LiDAR</span>
              <span class="cfg-option-price">+₱1,850.00</span>
            </div>
            <p class="cfg-option-desc">Single-point Time-of-Flight laser rangefinder measuring up to 12 meters with 1000Hz frame rate for SLAM robotics.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">12m Laser ToF</span>
              <span class="cfg-spec-pill">UART & I2C</span>
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between;">
          <button type="button" class="btn btn--outline" data-cfg-prev="step-1">
            Back to MCU
          </button>
          <button type="button" class="btn btn--primary" data-cfg-next="step-3">
            Proceed to Actuators
            {% render 'icon', name: 'chevron-right' %}
          </button>
        </div>
      </div>

      <!-- Step 3: Actuation & Prototyping -->
      <div class="cfg-step-content" data-cfg-step="step-3">
        <div style="margin-bottom: 1.25rem;">
          <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Step 3: Add Actuation, Switching & Breadboard Gear</h3>
          <p style="font-size: 0.875rem; color: var(--color-text-muted);">Choose power relays, motor controllers, servo steering, or breadboard wires.</p>
        </div>

        <div class="cfg-grid-options">
          <!-- Solderless Breadboard & Wires -->
          <div class="cfg-option-card selected" data-component="act-breadboard" data-price="175" data-name="Master Solderless Breadboard & 65-pc Jumper Wires" data-sku="JT-ACC-BB830-65J">
            <div class="cfg-option-header">
              <span class="cfg-option-title">Breadboard & 65-pc Wires</span>
              <span class="cfg-option-price">+₱175.00</span>
            </div>
            <p class="cfg-option-desc">Standard 830-point MB-102 solderless breadboard with dual power rails and 65 multi-color male-to-male flexible jumpers.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">830-Point Grid</span>
              <span class="cfg-spec-pill">65 Flexible Wires</span>
            </div>
          </div>

          <!-- 4-Channel Relay -->
          <div class="cfg-option-card" data-component="act-relay" data-price="165" data-name="4-Channel 5V Relay Module with Optocoupler" data-sku="JT-MOD-RELAY4-5V">
            <div class="cfg-option-header">
              <span class="cfg-option-title">4-Channel 5V Isolated Relay</span>
              <span class="cfg-option-price">+₱165.00</span>
            </div>
            <p class="cfg-option-desc">Optocoupler-isolated relay module capable of safely switching 250VAC/10A or 30VDC appliances with optical protection.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">250VAC 10A</span>
              <span class="cfg-spec-pill">Opto-Isolated</span>
            </div>
          </div>

          <!-- L298N Motor Driver -->
          <div class="cfg-option-card" data-component="act-motor" data-price="120" data-name="L298N Dual H-Bridge DC Motor Driver" data-sku="JT-MOD-L298N-2A">
            <div class="cfg-option-header">
              <span class="cfg-option-title">L298N Dual H-Bridge Driver</span>
              <span class="cfg-option-price">+₱120.00</span>
            </div>
            <p class="cfg-option-desc">Drives two DC motors bidirectionally with PWM speed modulation or one 4-wire two-phase stepper up to 2A per channel.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">Dual 2A Peak</span>
              <span class="cfg-spec-pill">PWM Speed Control</span>
            </div>
          </div>

          <!-- SG90 Micro Servo -->
          <div class="cfg-option-card" data-component="act-servo" data-price="95" data-name="SG90 9g Micro Servo Motor" data-sku="JT-ACT-SG90-9G">
            <div class="cfg-option-header">
              <span class="cfg-option-title">SG90 9g Micro Servo Motor</span>
              <span class="cfg-option-price">+₱95.00</span>
            </div>
            <p class="cfg-option-desc">Lightweight 180° rotation actuator with 1.6 kg-cm stall torque. Includes 3 servo horns and hardware for sensor sweeps.</p>
            <div class="cfg-option-specs">
              <span class="cfg-spec-pill">180° Rotation</span>
              <span class="cfg-spec-pill">1.6 kg-cm Torque</span>
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-start;">
          <button type="button" class="btn btn--outline" data-cfg-prev="step-2">
            Back to Sensors
          </button>
        </div>
      </div>

      <!-- Live Telemetry & Pricing HUD (Always Visible across all steps) -->
      <div class="cfg-live-hud">
        <div class="cfg-telemetry-status">
          <div class="cfg-voltage-pill">
            <span style="color: var(--color-sale);">●</span>
            <span data-cfg-voltage-status>100% Bench Synergy: Logic Safe & Bus Verified</span>
          </div>
          <div class="cfg-score-gauge">
            <div>
              <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--color-text-dim); font-weight: 700;">Deterministic Quality Rating</div>
              <div style="display: flex; align-items: baseline; gap: 0.25rem;">
                <span class="cfg-score-val" data-cfg-score>91.8</span>
                <span style="font-size: 0.9375rem; color: var(--color-text-dim); font-weight: 700;">/ 100</span>
              </div>
            </div>
            <div style="font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.4; border-left: 1px solid var(--color-border); padding-left: 0.75rem;">
              Calculated via KitFlow Algorithm: 35% Sales, 25% Pin Synergy, 20% Inventory, 20% Bundle Efficiency.
            </div>
          </div>
        </div>

        <div class="cfg-pricing-block">
          <div class="cfg-price-subtotal">
            Original: <span data-cfg-subtotal>₱795.00</span>
          </div>
          <div class="cfg-price-total" data-cfg-total>
            ₱675.00
          </div>
          <div class="cfg-savings-badge" data-cfg-savings>
            Save 15% (₱120.00 Bundle Discount)
          </div>
          <button type="button" class="btn btn--primary btn--lg btn--full" style="margin-top: 0.75rem;" data-cfg-add-cart>
            {% render 'icon', name: 'cart' %}
            <span>Add Complete Kit to Cart</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hardware Configurator",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Interactive Hardware Lab & Kit Configurator"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Design your custom maker setup. Pick a microcontroller, attach telemetry sensors, configure motor or relay switching, and watch voltage logic safety and bundle savings calculate in real time."
    }
  ],
  "presets": [
    {
      "name": "Hardware Configurator"
    }
  ]
}
{% endschema %}
