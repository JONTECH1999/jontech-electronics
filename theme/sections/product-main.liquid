{% comment %}
  JonTech Electronics - Product Main Section
  Warm Linen & Beige Aesthetic with Technical Specifications Tabs
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign is_available = current_variant.available
-%}

<section class="product-page" role="region" aria-label="Product Details">
  <div class="container">
    <div class="product-layout">
      <!-- Gallery Column -->
      <div class="product-gallery">
        <div class="product-gallery__main">
          {%- if featured_image != blank -%}
            <img
              src="{{ featured_image | image_url: width: 800 }}"
              alt="{{ featured_image.alt | default: product.title | escape }}"
              class="product-gallery__img"
              width="800"
              height="800"
            >
          {%- else -%}
            <div class="product-card__placeholder" style="height: 100%; min-height: 480px;">
              <span style="color: var(--color-primary);">{% render 'icon', name: 'cpu', class: 'placeholder-icon' %}</span>
              <span style="font-size: 1.125rem; font-weight: 700; color: var(--color-heading);">JonTech Precision Hardware</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Info & Purchase Column -->
      <div class="product-info">
        {%- if product.vendor != blank -%}
          <p class="product-info__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-info__title">{{ product.title | default: 'ESP32 IoT Smart Weather & Telemetry Kit' }}</h1>

        <div class="product-info__price-block">
          {% render 'price', product: product, show_savings: true %}
        </div>

        <!-- Inventory / Stock Indicator -->
        <div class="stock-indicator">
          {%- if is_available -%}
            <span class="stock-dot"></span>
            <span style="color: var(--color-sale); font-weight: 700;">
              {%- if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
                Only {{ current_variant.inventory_quantity }} units left in stock · Manila Warehouse Dispatch
              {%- else -%}
                In Stock & Bench-Tested · Ready for Courier Dispatch
              {%- endif -%}
            </span>
          {%- else -%}
            <span class="stock-dot stock-dot--warning"></span>
            <span style="color: var(--color-warning); font-weight: 700;">Temporarily Out of Stock</span>
          {%- endif -%}
        </div>

        <!-- Add to Cart Form -->
        <form method="post" action="{{ routes.cart_add_url }}" class="product-form" data-product-form>
          <!-- Variant Selector if multiple variants exist -->
          {%- if product.variants.size > 1 -%}
            <div class="variant-select-wrapper" style="margin-bottom: 1.5rem;">
              <label for="ProductSelect-{{ section.id }}" style="display: block; font-size: 0.875rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-heading);">
                Select Hardware Configuration / Edition
              </label>
              <select
                name="id"
                id="ProductSelect-{{ section.id }}"
                class="sort-select"
                style="width: 100%; padding: 0.85rem 1rem;"
              >
                {%- for variant in product.variants -%}
                  {%- assign opt_money = variant.price | money -%}
                  {%- if opt_money contains '$' or cart.currency.iso_code == 'PHP' or settings.currency_symbol == '₱' or settings.currency_symbol == blank -%}
                    {%- assign raw_price = variant.price | money_without_currency -%}
                    {%- assign opt_price_str = '₱' | append: raw_price -%}
                  {%- else -%}
                    {%- assign opt_price_str = opt_money -%}
                  {%- endif -%}
                  <option
                    {% if variant == current_variant %}selected="selected"{% endif %}
                    {% unless variant.available %}disabled="disabled"{% endunless %}
                    value="{{ variant.id }}"
                  >
                    {{ variant.title }} - {{ opt_price_str }}
                    {% unless variant.available %} (Sold Out){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id | default: 1 }}">
          {%- endif -%}

          <!-- Quantity Selector -->
          <div class="quantity-wrapper" data-qty-wrapper>
            <span style="font-size: 0.875rem; font-weight: 700; color: var(--color-heading);">Quantity:</span>
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" data-qty-btn="minus" aria-label="Decrease quantity">-</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="quantity-input"
                aria-label="Product quantity"
              >
              <button type="button" class="quantity-btn" data-qty-btn="plus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <!-- Actions -->
          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            {%- if is_available -%}
              <button type="submit" name="add" class="btn btn--primary btn--lg" style="flex: 2; min-width: 200px;">
                {% render 'icon', name: 'cart' %}
                <span>Add to Cart</span>
              </button>
            {%- else -%}
              <button type="button" class="btn btn--disabled btn--lg btn--full" disabled>
                Sold Out
              </button>
            {%- endif -%}
          </div>
        </form>

        <!-- Curated Setup / Bundle Value Prop Box -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <span style="color: var(--color-primary);">{% render 'icon', name: 'zap' %}</span>
            <span style="font-weight: 800; color: var(--color-heading); font-size: 0.9375rem;">KitFlow Hardware Synergy Guarantee</span>
          </div>
          <p style="font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.55;">
            Verified for seamless integration into maker circuits. Every component passes our 4-factor scoring protocol: 35% Sales Validation, 25% Hardware Voltage Synergy, 20% Inventory Health, and 20% Bundle Discount Efficiency.
          </p>
        </div>

        <!-- Technical Specifications Accordion -->
        <div class="product-specs-accordion">
          <div class="specs-tab-header">
            <span>Hardware Specifications & Pinouts</span>
            <span style="color: var(--color-primary);">▾</span>
          </div>
          <div class="specs-tab-content">
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem;">
              <li><strong>Operating Logic Voltage:</strong> 3.3V / 5V DC (Bench-verified with level shifters)</li>
              <li><strong>Breadboard Compatibility:</strong> Standard 2.54mm (0.1") pitch male header pins</li>
              <li><strong>Communication Interfaces:</strong> I2C (SDA/SCL), SPI (MISO/MOSI/SCK), UART (TX/RX), PWM</li>
              <li><strong>Firmware Support:</strong> Arduino IDE, MicroPython, CircuitPython, Espressif ESP-IDF, ROS 2</li>
            </ul>
          </div>
        </div>

        <!-- Description -->
        <div class="product-description" style="margin-top: 2rem;">
          <h3 style="font-size: 1.2rem; margin-bottom: 0.85rem; color: var(--color-heading); font-weight: 700;">Product Description & Lab Notes</h3>
          {%- if product.description != blank -%}
            <div class="rte">
              {{ product.description }}
            </div>
          {%- else -%}
            <p>
              Pre-tested electronic prototyping hardware curated by JonTech Engineering. Each board is tested on our physical test jig before packaging to guarantee undamaged GPIO lines, factory firmware boot, and clean voltage regulation.
            </p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    }
  ]
}
{% endschema %}
