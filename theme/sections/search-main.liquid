{% comment %}
  JonTech Electronics - Search Main Section
{% endcomment %}

<div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="max-width: 680px; margin: 0 auto 3rem auto; text-align: center;">
    <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--color-heading); margin-bottom: 1rem;">
      Search Hardware Catalog
    </h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 0.5rem;">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search ESP32, sensors, motors, robotics..."
        class="input"
        style="flex: 1; padding: 0.85rem 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface);"
      >
      <button type="submit" class="btn btn--primary" style="padding: 0.85rem 1.75rem;">
        {% render 'icon', name: 'search' %} Search
      </button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div style="text-align: center; padding: 4rem 1rem; background: var(--color-surface); border-radius: var(--radius-xl); border: 1px solid var(--color-border);">
        <p style="color: var(--color-text-muted); font-size: 1.125rem;">
          No hardware found matching "{{ search.terms }}". Try searching for "ESP32", "LiDAR", "Relay", or "Sensor".
        </p>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search Main",
  "settings": []
}
{% endschema %}
