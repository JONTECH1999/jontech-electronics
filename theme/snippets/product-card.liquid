{% comment %}
  Renders a product card for grids (Featured Products, Collections, Search)
  Usage: {% render 'product-card', product: product %}
{% endcomment %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_available = current_variant.available
  assign is_on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign is_on_sale = true
  endif
-%}

<article class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="product-card__image"
          loading="lazy"
          width="600"
          height="600"
        >
      {%- else -%}
        <div class="product-card__placeholder">
          {% render 'icon', name: 'cpu', class: 'placeholder-icon' %}
          <span>JonTech Curated Gear</span>
        </div>
      {%- endif -%}
    </a>

    <div class="product-card__badges">
      {%- if is_on_sale -%}
        {% render 'badge', type: 'sale', text: 'SALE' %}
      {%- endif -%}
      {%- if product.tags contains 'bundle' or product.type contains 'Bundle' -%}
        {% render 'badge', type: 'bundle', text: 'CURATED BUNDLE' %}
      {%- endif -%}
      {%- unless is_available -%}
        {% render 'badge', type: 'warning', text: 'SOLD OUT' %}
      {%- endunless -%}
    </div>
  </div>

  <div class="product-card__content">
    {%- if product.vendor != blank -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product.url }}" class="product-card__title-link">
        {{ product.title }}
      </a>
    </h3>

    <div class="product-card__price">
      {% render 'price', product: product, show_savings: true %}
    </div>

    <div class="product-card__actions">
      {%- if is_available -%}
        <form method="post" action="{{ routes.cart_add_url }}" class="product-card__form" data-product-form>
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            name="add"
            class="btn btn--secondary btn--sm btn--full"
            aria-label="Add {{ product.title | escape }} to cart"
          >
            {% render 'icon', name: 'cart', class: 'btn-icon' %}
            <span>Add to Cart</span>
          </button>
        </form>
      {%- else -%}
        <button type="button" class="btn btn--disabled btn--sm btn--full" disabled>
          Out of Stock
        </button>
      {%- endif -%}
    </div>
  </div>
</article>
